// 最浪漫的事
// 演唱：赵咏华　作词：姚若龙　作曲：李正帆　编配：车冰冰
// 根据用户提供的完整曲谱截图转写；调性 C，4/4，72 BPM，标准调弦 E A D G B E。
// 说明：AlphaTab 渲染六线谱、节奏、和弦与歌词；简谱数字由同拍位 overlay 绘制。

\title "最浪漫的事"
\subtitle "演唱：赵咏华"
\artist "赵咏华"
\music "李正帆"
\words "姚若龙"
\tempo 72
\defaultSystemsLayout 4
\chordDiagramsInScore true
\track "Acoustic Guitar" { instrument acousticGuitar }
\staff { tabs }
\tuning E2 A2 D3 G3 B3 E4
\ts (4 4)

// 到最浪漫的事，就是和你一起慢慢变老，一路上
:8 3.5 {ch "C" lyrics "到"} 0.3 {lyrics "最"} 1.2 {lyrics "浪"} 0.1 {lyrics "漫"} 1.2 {lyrics "的"} 0.3 {lyrics "事"} 3.5 0.3 |
:8 3.5 {ch "C"} 0.3 1.2 0.1 1.2 0.3 3.5 0.3 |
:8 0.5 {ch "Am" lyrics "就"} 0.3 {lyrics "是"} 1.2 {lyrics "和"} 0.1 {lyrics "你"} 1.2 {lyrics "一"} 0.3 {lyrics "起"} 0.5 0.3 |
:8 0.5 {ch "Am"} 0.3 {lyrics "慢"} 1.2 {lyrics "慢"} 0.1 {lyrics "变"} 1.2 {lyrics "老"} 0.3 0.5 0.3 |
:8 0.4 {ch "Dm" lyrics "一"} 2.3 {lyrics "路"} 3.2 {lyrics "上"} 1.1 3.2 2.3 0.4 2.3 |
:8 3.6 {ch "G" lyrics "收"} 0.3 {lyrics "藏"} 0.2 {lyrics "点"} 0.1 {lyrics "点"} 0.2 {lyrics "滴"} 0.3 {lyrics "滴"} 3.6 0.3 |
:8 3.6 {ch "G" lyrics "的"} 0.3 {lyrics "欢"} 0.2 {lyrics "笑"} 0.1 0.2 0.3 3.6 0.3 |
:8 3.5 {ch "C" lyrics "留"} 0.3 {lyrics "到"} 1.2 {lyrics "以"} 0.1 {lyrics "后"} 1.2 {lyrics "坐"} 0.3 {lyrics "着"} 3.5 0.3 |

// 坐着摇椅慢慢聊，我能想到最浪漫的事
:8 0.5 {ch "Am" lyrics "摇"} 0.3 {lyrics "椅"} 1.2 {lyrics "慢"} 0.1 {lyrics "慢"} 1.2 {lyrics "聊"} 0.3 0.5 0.3 |
:8 0.4 {ch "Dm" lyrics "我"} 2.3 {lyrics "能"} 3.2 {lyrics "想"} 1.1 3.2 2.3 0.4 2.3 |
