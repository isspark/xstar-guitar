:8 3.6 {ch "Gadd11" lyrics "当"} 0.3 {lyrics "成"} 0.2 {lyrics "手"} 0.1 {lyrics "心"} 0.2 {lyrics "里"} 0.3 {lyrics "的"} 3.6 {lyrics "宝"} 0.3 |
