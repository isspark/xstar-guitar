:8 0.5 {ch "Am" lyrics "慢"} 0.3 {lyrics "慢"} 1.2 {lyrics "变"} 0.1 {lyrics "老"} 1.2 0.3 0.5 0.3 |
:8 0.4 {ch "Dm" lyrics "直"} 2.3 {lyrics "到"} 3.2 {lyrics "我"} 1.1 {lyrics "们"} 3.2 2.3 0.4 2.3 |
:8 3.6 {ch "G" lyrics "老"} 0.3 {lyrics "的"} 0.2 {lyrics "哪"} 0.1 {lyrics "儿"} 0.2 {lyrics "也"} 0.3 {lyrics "去"} 3.6 {lyrics "不"} 0.3 |
:8 3.6 {ch "G" lyrics "了"} 0.3 {lyrics "你"} 0.2 {lyrics "还"} 0.1 {lyrics "依"} 0.2 {lyrics "然"} 0.3 {lyrics "把"} 3.6 {lyrics "我"} 0.3 |

