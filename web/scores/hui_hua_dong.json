    "review": [
      { "measures": [2, 26, 34, 43], "detail": "高音1弦3→5的H按前倚音连接到琶音和弦；原图装饰音占时没有定量，播放采用解析器默认值。" },
      { "measures": [9], "detail": "原图琶音和弦后的延长记号无指定秒数，采用medium 1；低音按附点四分+二分+八分休止分配，结束消音时刻需复核。" },
      { "measures": [12, 13, 20, 21], "detail": "细小滑音按图读取：12/20为2弦2→3后延续；13/21为3弦2→3→2装饰音，再到4弦0。需高清原图复核装饰音时值。" },
      { "measures": [25], "detail": "低音声部按空5弦两次八分音符、八分休止、空5弦二分音符和八分休止录入；琶音上下声部共享起点，低音结束时刻需复核。" },
      { "measures": [34, 43], "detail": "低音四分音符延至后一八分，之后休止；原图旋律长音与低音独立保留。" },
      { "measures": [49, 50, 52], "detail": "49小节上声部是单音，不补前文双音；50小节低音0在4弦，52小节终止低音3在6弦。末和弦为6弦3、4弦4、2弦0、1弦2，未补未印出的弦。" }
