  "composition": {
    "theme": "远行与归来：把守候唱成一盏灯",
    "vocalRange": {"lowest": "B3", "highest": "E5"},
    "sections": [
      {"name": "前奏", "firstMeasure": 1, "lastMeasure": 4},
      {"name": "主歌", "firstMeasure": 5, "lastMeasure": 12},
      {"name": "预副歌", "firstMeasure": 13, "lastMeasure": 16},
      {"name": "副歌", "firstMeasure": 17, "lastMeasure": 24},
      {"name": "尾奏", "firstMeasure": 25, "lastMeasure": 28}
    ],
    "lyrics": {
      "主歌": ["晚风经过长街，吹散一天疲倦。", "你把沉默折好，藏进我的掌间。", "窗外最后班车，驶向远方的夜。", "我将你的名字，轻轻写进明天。"],
      "预副歌": ["若是世界太远，别怕脚步太慢。", "还有一盏灯火，等你穿过风寒。"],
      "副歌": ["我为你留盏灯，照亮回家的门。", "任凭岁月多深，你仍是心上人。", "把未说完的话，唱给漫天星辰。", "等到天色微明，与你相拥一生。"]
    }
  },
